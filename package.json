{
  "name": "dsh-loopback-spoof",
  "version": "0.2.0",
  "private": true,
  "description": "Expose the official DSH Web profile on LAN by default while presenting its browser Connection as loopback.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fangzhengjin/dsh-loopback-spoof.git"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build:host": "node scripts/run-tsc.mjs build",
    "build:client": "node scripts/build-client.mjs",
    "build": "pnpm run clean && pnpm run build:host && pnpm run build:client",
    "check:public": "node scripts/check-public-content.mjs",
    "build:package": "pnpm run build && pnpm run check:public",
    "typecheck": "node scripts/run-tsc.mjs typecheck",
    "test": "vitest run",
    "test:integration": "node tests/dsh-profile.integration.mjs",
    "test:tarball": "pnpm run build:package && node tests/tarball.integration.mjs",
    "check:quick": "pnpm run typecheck && pnpm run test && pnpm run build:package",
    "check": "pnpm run check:quick && node tests/tarball.integration.mjs",
    "pack:check": "pnpm run build:package && pnpm pack --dry-run"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "packageManager": "pnpm@11.7.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-connection": "0.1.3-alpha.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
